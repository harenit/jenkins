# PrepCycle Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit real secrets.

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DEFAULT_ADMIN_EMAIL=admin@prepcycle.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/apple/callback

# AI / Chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Email Communication Provider
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# SMS Communication Provider
SMS_PROVIDER=twilio
SMS_API_KEY=

# WhatsApp Communication Provider
WHATSAPP_PROVIDER=meta-whatsapp-cloud
WHATSAPP_API_KEY=
